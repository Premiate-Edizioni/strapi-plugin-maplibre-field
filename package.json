{
  "name": "@premiate/strapi-plugin-maplibre-field",
  "version": "1.7.0",
  "description": "Strapi plugin that provides a MapLibre custom field",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Premiate-Edizioni/strapi-plugin-maplibre-field.git"
  },
  "bugs": {
    "url": "https://github.com/Premiate-Edizioni/strapi-plugin-maplibre-field/issues"
  },
  "homepage": "https://community.strapi.io/marketplace/premiate-strapi-plugin-maplibre-field",
  "strapi": {
    "name": "maplibre-field",
    "description": "Add a location field to your content types using MapLibre: pick a point on an interactive map or search for an address.",
    "kind": "plugin",
    "displayName": "MapLibre Field"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "logo.png"
  ],
  "types": "./dist/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "typecheck:watch": "tsc --watch --preserveWatchOutput",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint admin/src server/src tests",
    "lint:fix": "eslint admin/src server/src tests --fix",
    "format": "prettier --write \"admin/src/**/*.{ts,tsx}\" \"server/src/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"admin/src/**/*.{ts,tsx}\" \"server/src/**/*.ts\" \"tests/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build && npm run verify && npm test"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1",
    "pmtiles": "^4.5.0",
    "react-map-gl": "^8.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@strapi/sdk-plugin": "^6.1.0",
    "@strapi/typescript-utils": "^5.52.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Claudio Bernardini",
    "email": "claudiob@premiate.org",
    "url": "https://premiate.org"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x"
  },
  "license": "MIT",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "plugin",
    "maplibre",
    "nominatim",
    "protomaps",
    "pmtiles",
    "strapi5"
  ]
}
